<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background"
    android:orientation="vertical"
    tools:context=".DashboardActivity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:layout_weight="1">
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="20dp"
        android:isScrollContainer="true"
        android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="250dp"
                android:layout_height="70dp"
                android:layout_centerInParent="true"
                android:src="@drawable/wealthwave_logo"
                android:contentDescription="@string/app_name" />
        </RelativeLayout>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:backgroundTint="@color/md_theme_light_secondaryContainer">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                >
                <TextView
                    android:id="@+id/amount_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Remaining Budget"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_light_primary"/>
                <TextView
                    android:id="@+id/amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/amount_text"
                    android:text="KES 33000/40000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_primary"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:backgroundTint="@color/md_theme_light_secondaryContainer"
            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">
                <TextView
                    android:id="@+id/spend_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Dec Spending"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_light_primary"/>
                <TextView
                    android:id="@+id/amount_spent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/spend_text"
                    android:text="KES 33000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_primary"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:backgroundTint="@color/md_theme_light_secondaryContainer">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">
                <TextView
                    android:id="@+id/recent_spend_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Recent Spending"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_light_primary"/>
                <TextView
                    android:id="@+id/recent_spend_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/recent_spend_text"
                    android:text="KES 3000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_primary"/>
                <TextView
                    android:id="@+id/time_in_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/recent_spend_amount"
                    android:text="In the last 7days"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_light_primary"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:backgroundTint="@color/md_theme_light_secondaryContainer">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">
                <TextView
                    android:id="@+id/expense_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Upcoming Expenses"
                    android:textColor="@color/md_theme_light_primary"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/expense_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@id/expense_label"
                    android:text="KES 200000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_primary"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/expense_amount"
                    android:text="KES 70000/200000 paid"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_light_primary"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:backgroundTint="@color/md_theme_light_secondaryContainer">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">
                <TextView
                    android:id="@+id/balance_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Available Balance"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_light_primary"/>
                <TextView
                    android:id="@+id/balance_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/balance_label"
                    android:text="KES 7000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_light_primary"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:backgroundTint="@color/md_theme_light_secondaryContainer">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp">
                <TextView
                    android:id="@+id/cash_flow_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Recent Spending"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_light_primary"/>
                <RelativeLayout
                    android:id="@+id/cash_flow_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/cash_flow_label">
                    <TextView
                        android:id="@+id/cash_flow_symbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_alignParentStart="true"
                        android:text="+"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_light_primary"/>
                    <TextView
                        android:id="@+id/cash_flow_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/cash_flow_symbol"
                        android:text="KES 30000"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/md_theme_light_primary"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/income_cash_flow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_below="@+id/cash_flow_layout"
                    android:text="@string/income_text"
                    android:textSize="13sp"
                    android:textColor="@color/md_theme_light_primary"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    </ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@color/md_theme_light_secondaryContainer"
        android:elevation="0dp"
        app:itemIconTint="@color/md_theme_light_onPrimaryContainer"
        app:itemTextColor="@color/md_theme_light_onPrimaryContainer"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"/>
</LinearLayout>