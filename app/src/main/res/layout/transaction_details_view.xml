<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2.5dp"
    android:backgroundTint="@color/md_theme_light_secondaryContainer">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp"
        android:paddingHorizontal="15sp"
        >
        <TextView
            android:id="@+id/budget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Transaction"
            android:textSize="15sp"
            android:textColor="@color/md_theme_light_primary"/>
        <TextView
            android:id="@+id/budget_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/budget_name"
            android:text="@string/zero_amt"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary"/>

        <ImageButton
            style="@style/Widget.Material3.Button.TextButton"
            android:id="@+id/menu_items"
            android:src="@drawable/three_dots_svgrepo_com"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_alignEnd="@+id/budget_amount"
            android:layout_alignParentEnd="true"
            android:contentDescription="Menu items"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            android:textColor="@color/md_theme_light_primary" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
